ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-haiku-latest
MAX_LLM_ITEMS_PER_RUN=5
MAX_CHARS_PER_ITEM=8000
LLM_TIMEOUT_SECONDS=60
RECENT_DEVELOPMENT_START_DATE=2026-05-01
ALLOW_UNDATED_RECENT_ITEMS=false
ALLOW_LOW_DATE_CONFIDENCE=false
ALLOW_END_DATE_RECENCY=false

# Shared benchmark research queue (Supabase session pooler, SSL required).
# Leave unset for local SQLite and local subprocess workers.
# BENCHMARK_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# BENCHMARK_WORKER_MODE=external
